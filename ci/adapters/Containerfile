# The image the cpak release builds in.
#
# It exists so that a release never runs apt. Installing the GTK and Qt
# development packages on a shared runner hung the release for forty minutes at
# a time, twice, and never said what it was waiting for. Here it happens once,
# and a release either pulls an image or does not.
#
# Debian and not the platform base on purpose. This image compiles the desktop
# adapters that ship inside cpak and then run on somebody else's machine, so
# the glibc and toolkit versions they are linked against become the oldest
# system that can run them. It is also a build image, not a runtime one: it
# keeps the headers and the package lists a cpak image throws away.
FROM debian:trixie-slim

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        build-essential \
        pkg-config \
        git \
        ca-certificates \
        libgtk-3-dev \
        libadwaita-1-dev \
        qt6-base-dev && \
    rm -rf /var/lib/apt/lists/*

# A missing toolkit fails here, where the image is built, instead of in the
# release that was counting on it.
RUN pkg-config --exists gtk+-3.0 libadwaita-1 Qt6Widgets && \
    cc --version >/dev/null && c++ --version >/dev/null && git --version >/dev/null
